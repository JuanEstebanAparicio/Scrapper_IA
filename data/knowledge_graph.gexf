      <node id="# Caso de uso 2 - https://gerardoesquivia.com/langchain/&#10;# pip install -U langchain &quot;langchain[google-genai]&quot;&#10;# export GOOGLE_API_KEY=&quot;tu-api-key&quot;&#10;&#10;from langchain.agents import create_agent&#10;&#10;# 1. Herramienta = funciÃ³n Python normal. El docstring es CRÃTICO.&#10;def get_weather(city: str) -&gt; str:&#10;    &quot;&quot;&quot;Get weather for a given city.&quot;&quot;&quot;&#10;    return f&quot;It's always sunny in {city}!&quot;&#10;&#10;# 2. Crear el agente: modelo + herramientas + prompt de sistema.&#10;agent = create_agent(&#10;    model=&quot;google_genai:gemini-2.5-flash-lite&quot;,  # proveedor:modelo&#10;    tools=[get_weather],&#10;    system_prompt=&quot;You are a helpful assistant&quot;,&#10;)&#10;&#10;# 3. Invocar: el mensaje entra como lista de {role, content}.&#10;result = agent.invoke(&#10;    {&quot;messages&quot;: [{&quot;role&quot;: &quot;user&quot;, &quot;content&quot;: &quot;What's the weather in San Francisco?&quot;}]}&#10;)&#10;&#10;# 4. La respuesta estÃ¡ en el ÃLTIMO mensaje.&#10;print(result[&quot;messages&quot;][-1].content_blocks)&#10;" label="# Caso de uso 2 - https://gerardoesquivia.com/langchain/&#10;# pip install -U langchain &quot;langchain[google-genai]&quot;&#10;# export GOOGLE_API_KEY=&quot;tu-api-key&quot;&#10;&#10;from langchain.agents import create_agent&#10;&#10;# 1. Herramienta = funciÃ³n Python normal. El docstring es CRÃTICO.&#10;def get_weather(city: str) -&gt; str:&#10;    &quot;&quot;&quot;Get weather for a given city.&quot;&quot;&quot;&#10;    return f&quot;It's always sunny in {city}!&quot;&#10;&#10;# 2. Crear el agente: modelo + herramientas + prompt de sistema.&#10;agent = create_agent(&#10;    model=&quot;google_genai:gemini-2.5-flash-lite&quot;,  # proveedor:modelo&#10;    tools=[get_weather],&#10;    system_prompt=&quot;You are a helpful assistant&quot;,&#10;)&#10;&#10;# 3. Invocar: el mensaje entra como lista de {role, content}.&#10;result = agent.invoke(&#10;    {&quot;messages&quot;: [{&quot;role&quot;: &quot;user&quot;, &quot;content&quot;: &quot;What's the weather in San Francisco?&quot;}]}&#10;)&#10;&#10;# 4. La respuesta estÃ¡ en el ÃLTIMO mensaje.&#10;print(result[&quot;messages&quot;][-1].content_blocks)&#10;">
